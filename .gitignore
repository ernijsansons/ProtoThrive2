# Thermonuclear .gitignore for ProtoThrive
# Ref: CLAUDE.md Phase 6 - Root Repo Setup

# Dependencies
node_modules/
venv/
__pycache__/
.venv/

# Build outputs
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/
.coverage

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cloudflare Workers
.wrangler/

# Python specific
*.pyc
*.pyo
*.pyd
__pycache__/
.pytest_cache/

# Node.js specific
.npm
.node_repl_history

# TypeScript
*.tsbuildinfo

# Temporary files
.tmp/
temp/-e 
# SECURITY: Environment and secrets files
*.env
*.env.*
.env.backup
.env.example.local
*secrets*
*keys*
*.key
*.pem
*.p12
*.pfx
.wrangler/
wrangler.toml.local

# SECURITY: Configuration files that may contain secrets
config/production.json
config/staging.json
src/config/secrets.ts
src/config/keys.ts
settings.local.json
.claude/settings.local.json

# SECURITY: Authentication and tokens
jwt.key
oauth.json
auth.json
tokens/
credentials/

# SECURITY: Database and backup files
*.sql.backup
*.db.backup
dumps/
backups/

# SECURITY: Log files that may contain sensitive data
audit.log
access.log
error.log
security.log

# Problematic files
nul
NUL

# Embedded git repositories
**/.git/

# Agent backups (keep active ones only)
.claude/agents-backup-*/

# Large temporary files and reports
**/claude-agents-*.zip
thermonuclear-*.json
*-report.json
*-report.md
validation_*.py
*_REPORT.md

# Production Environment Variables for ProtoThrive Frontend
# Update these with your actual production values

# Application URLs
NEXT_PUBLIC_APP_URL=https://protothrive-frontend.pages.dev
NEXT_PUBLIC_API_URL=https://backend-thermo-staging.ernijs-ansons.workers.dev
NEXT_PUBLIC_WS_URL=wss://backend-thermo-staging.ernijs-ansons.workers.dev

# Clerk Authentication (Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_live_XXXXXXXXXXXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Spline 3D Scene
NEXT_PUBLIC_SPLINE_SCENE=https://prod.spline.design/neon-cube-thermo/scene.splinecode

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_API_MOCKING=disabled
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_ENABLE_AI=true

# Third-party Services
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx@sentry.io/xxxxxxxxxxxxx
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=pub_xxxxxxxxxxxxx
NEXT_PUBLIC_DATADOG_APPLICATION_ID=xxxxxxxxxxxxx

# Stripe (if using payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXX

# AI Services
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_AI_MODEL_DEFAULT=enterprise-v3.4

# Performance & Optimization
NEXT_PUBLIC_IMAGE_OPTIMIZATION_DOMAIN=images.protothrive.com
NEXT_PUBLIC_CDN_URL=https://cdn.protothrive.com

# Security Headers (for CSP)
NEXT_PUBLIC_CSP_REPORT_URI=https://api.protothrive.com/api/csp-report
# Staging Environment Variables for ProtoThrive Frontend

# Application URLs
NEXT_PUBLIC_APP_URL=https://staging.protothrive-frontend.pages.dev
NEXT_PUBLIC_API_URL=https://backend-thermo-staging.ernijs-ansons.workers.dev
NEXT_PUBLIC_WS_URL=wss://backend-thermo-staging.ernijs-ansons.workers.dev

# Clerk Authentication (Staging)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXX
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Spline 3D Scene (Staging)
NEXT_PUBLIC_SPLINE_SCENE=https://prod.spline.design/neon-cube-thermo/scene.splinecode

# Feature Flags (Staging)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
NEXT_PUBLIC_API_MOCKING=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Third-party Services (Staging)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-STAGING-XXXXX
NEXT_PUBLIC_SENTRY_DSN=https://staging-xxxxxxxxxxxxx@sentry.io/xxxxxxxxxxxxx
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=pub_staging_xxxxxxxxxxxxx
NEXT_PUBLIC_DATADOG_APPLICATION_ID=staging_xxxxxxxxxxxxx

# Stripe (Staging)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXX

# AI Services (Staging)
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_AI_MODEL_DEFAULT=enterprise-v3.4

# Performance & Optimization (Staging)
NEXT_PUBLIC_IMAGE_OPTIMIZATION_DOMAIN=staging-images.protothrive.com
NEXT_PUBLIC_CDN_URL=https://staging-cdn.protothrive.com

# Security Headers (Staging)
NEXT_PUBLIC_CSP_REPORT_URI=https://backend-thermo-staging.ernijs-ansons.workers.dev/api/csp-report
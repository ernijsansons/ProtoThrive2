{
  "name": "protothrive-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5000",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "build:production": "cross-env NODE_ENV=production next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-5000}",
    "start:production": "cross-env NODE_ENV=production next start -H 0.0.0.0 -p ${PORT:-5000}",
    "typecheck": "tsc --noEmit",
    "lint": "next lint && stylelint 'src/**/*.css' --allow-empty-input",
    "lint:fix": "next lint --fix && stylelint 'src/**/*.css' --fix --allow-empty-input",
    "lint:a11y": "eslint src --ext .js,.jsx,.ts,.tsx --plugin jsx-a11y",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:performance": "playwright test e2e/performance.spec.ts",
    "test:load": "artillery run load-testing/api-load-test.js",
    "test:load:report": "artillery run load-testing/api-load-test.js --output test-results/load-test-report.json",
    "test:all": "npm run test:ci && npm run test:e2e && npm run typecheck && npm run lint",
    "test:ui": "npm run lint:a11y && npm run test:a11y",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "validate": "npm run typecheck && npm run build",
    "validate:all": "npm run test:all && npm run build",
    "deploy": "npm run validate && npm run start:production",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:cloudflare": "./deploy-cloudflare.sh",
    "deploy:cloudflare:staging": "./deploy-cloudflare.sh staging",
    "deploy:cloudflare:production": "./deploy-cloudflare.sh production",
    "deploy:docker": "docker build -t protothrive-frontend . && docker run -p 5000:5000 protothrive-frontend",
    "optimize": "npm run build:production && npm run test:performance",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "@clerk/nextjs": "6.32.0",
    "@heroicons/react": "^2.2.0",
    "@next/bundle-analyzer": "^14.0.0",
    "@splinetool/react-spline": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "clsx": "^2.1.1",
    "critters": "0.0.23",
    "cross-env": "^7.0.3",
    "firebase": "^12.3.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reactflow": "^11.10.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.9.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.0",
    "artillery": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^29.7.0",
    "postcss": "^8.4.0",
    "stylelint": "^16.11.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-tailwindcss": "^0.0.7",
    "tailwindcss": "^3.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

# Ref: CLAUDE.md - Environment configuration for AI services
# Copy this file to .env.local and update with your actual API keys

# OpenAI Configuration (for real AI feedback)
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# AI Service Configuration
NEXT_PUBLIC_AI_MODEL=gpt-4o-mini
NEXT_PUBLIC_AI_COST_BUDGET=0.50
NEXT_PUBLIC_ENABLE_REAL_AI=true

# Development/Testing flags
NEXT_PUBLIC_MOCK_AI_CALLS=false
NEXT_PUBLIC_AI_DEBUG=true

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=wss://api.protothrive.com/ws

# Fallback to mock mode if keys not provided
# The system will automatically use mocks in development if API keys are missing
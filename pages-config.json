{
  "name": "protothrive-frontend",
  "production_branch": "main",
  "preview_deployment_setting": "custom",
  "preview_branch_includes": ["main", "staging", "dev"],
  "preview_branch_excludes": [],
  "build": {
    "command": "npm run build",
    "destination_dir": "out",
    "root_dir": "frontend",
    "web_analytics_tag": "enterprise_analytics",
    "web_analytics_token": "CLOUDFLARE_WEB_ANALYTICS_TOKEN"
  },
  "env_vars": {
    "production": {
      "NODE_ENV": "production",
      "NEXT_PUBLIC_API_URL": "https://api.protothrive.com",
      "NEXT_PUBLIC_WS_URL": "wss://api.protothrive.com",
      "NEXT_PUBLIC_ENVIRONMENT": "production",
      "NEXT_PUBLIC_SENTRY_DSN": "SENTRY_DSN_PRODUCTION",
      "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "CLERK_PUBLISHABLE_KEY_PROD",
      "NEXT_PUBLIC_MIXPANEL_TOKEN": "MIXPANEL_TOKEN_PROD",
      "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "STRIPE_PUBLISHABLE_KEY_PROD",
      "NEXT_PUBLIC_ENABLE_ANALYTICS": "true",
      "NEXT_PUBLIC_ENABLE_ERROR_REPORTING": "true",
      "NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING": "true",
      "NEXT_PUBLIC_CDN_URL": "https://cdn.protothrive.com",
      "NEXT_PUBLIC_UPLOAD_URL": "https://uploads.protothrive.com",
      "NEXT_PUBLIC_VERSION": "2.0.0",
      "NEXT_PUBLIC_BUILD_TIMESTAMP": "$CF_PAGES_COMMIT_SHA",
      "NEXT_PUBLIC_FEATURE_FLAGS": "enterprise,collaboration,sso,analytics",
      "NEXT_PUBLIC_MAX_FILE_SIZE": "10485760",
      "NEXT_PUBLIC_SUPPORTED_FILE_TYPES": "jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx",
      "NEXT_PUBLIC_RATE_LIMIT_REQUESTS": "1000",
      "NEXT_PUBLIC_RATE_LIMIT_WINDOW": "3600000",
      "NEXT_PUBLIC_SESSION_TIMEOUT": "86400000",
      "NEXT_PUBLIC_WEBSOCKET_RECONNECT_INTERVAL": "5000",
      "NEXT_PUBLIC_CACHE_TTL_SHORT": "300000",
      "NEXT_PUBLIC_CACHE_TTL_MEDIUM": "1800000",
      "NEXT_PUBLIC_CACHE_TTL_LONG": "3600000"
    },
    "staging": {
      "NODE_ENV": "staging",
      "NEXT_PUBLIC_API_URL": "https://staging-api.protothrive.com",
      "NEXT_PUBLIC_WS_URL": "wss://staging-api.protothrive.com",
      "NEXT_PUBLIC_ENVIRONMENT": "staging",
      "NEXT_PUBLIC_SENTRY_DSN": "SENTRY_DSN_STAGING",
      "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "CLERK_PUBLISHABLE_KEY_STAGING",
      "NEXT_PUBLIC_MIXPANEL_TOKEN": "MIXPANEL_TOKEN_STAGING",
      "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "STRIPE_PUBLISHABLE_KEY_STAGING",
      "NEXT_PUBLIC_ENABLE_ANALYTICS": "true",
      "NEXT_PUBLIC_ENABLE_ERROR_REPORTING": "true",
      "NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING": "true",
      "NEXT_PUBLIC_CDN_URL": "https://staging-cdn.protothrive.com",
      "NEXT_PUBLIC_UPLOAD_URL": "https://staging-uploads.protothrive.com",
      "NEXT_PUBLIC_VERSION": "2.0.0-staging",
      "NEXT_PUBLIC_BUILD_TIMESTAMP": "$CF_PAGES_COMMIT_SHA",
      "NEXT_PUBLIC_FEATURE_FLAGS": "enterprise,collaboration,sso,analytics,beta",
      "NEXT_PUBLIC_MAX_FILE_SIZE": "10485760",
      "NEXT_PUBLIC_SUPPORTED_FILE_TYPES": "jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx",
      "NEXT_PUBLIC_RATE_LIMIT_REQUESTS": "2000",
      "NEXT_PUBLIC_RATE_LIMIT_WINDOW": "3600000",
      "NEXT_PUBLIC_SESSION_TIMEOUT": "86400000",
      "NEXT_PUBLIC_WEBSOCKET_RECONNECT_INTERVAL": "3000",
      "NEXT_PUBLIC_CACHE_TTL_SHORT": "60000",
      "NEXT_PUBLIC_CACHE_TTL_MEDIUM": "300000",
      "NEXT_PUBLIC_CACHE_TTL_LONG": "900000"
    },
    "preview": {
      "NODE_ENV": "development",
      "NEXT_PUBLIC_API_URL": "https://preview-api.protothrive.com",
      "NEXT_PUBLIC_WS_URL": "wss://preview-api.protothrive.com",
      "NEXT_PUBLIC_ENVIRONMENT": "preview",
      "NEXT_PUBLIC_SENTRY_DSN": "SENTRY_DSN_PREVIEW",
      "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "CLERK_PUBLISHABLE_KEY_PREVIEW",
      "NEXT_PUBLIC_MIXPANEL_TOKEN": "MIXPANEL_TOKEN_PREVIEW",
      "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "STRIPE_PUBLISHABLE_KEY_PREVIEW",
      "NEXT_PUBLIC_ENABLE_ANALYTICS": "false",
      "NEXT_PUBLIC_ENABLE_ERROR_REPORTING": "false",
      "NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING": "false",
      "NEXT_PUBLIC_CDN_URL": "https://preview-cdn.protothrive.com",
      "NEXT_PUBLIC_UPLOAD_URL": "https://preview-uploads.protothrive.com",
      "NEXT_PUBLIC_VERSION": "2.0.0-preview",
      "NEXT_PUBLIC_BUILD_TIMESTAMP": "$CF_PAGES_COMMIT_SHA",
      "NEXT_PUBLIC_FEATURE_FLAGS": "enterprise,collaboration,sso,analytics,beta,experimental",
      "NEXT_PUBLIC_MAX_FILE_SIZE": "5242880",
      "NEXT_PUBLIC_SUPPORTED_FILE_TYPES": "jpg,jpeg,png,gif,pdf",
      "NEXT_PUBLIC_RATE_LIMIT_REQUESTS": "100",
      "NEXT_PUBLIC_RATE_LIMIT_WINDOW": "3600000",
      "NEXT_PUBLIC_SESSION_TIMEOUT": "3600000",
      "NEXT_PUBLIC_WEBSOCKET_RECONNECT_INTERVAL": "1000",
      "NEXT_PUBLIC_CACHE_TTL_SHORT": "10000",
      "NEXT_PUBLIC_CACHE_TTL_MEDIUM": "60000",
      "NEXT_PUBLIC_CACHE_TTL_LONG": "300000"
    }
  },
  "functions": {
    "env_vars": {
      "production": {
        "ENVIRONMENT": "production",
        "API_SECRET_KEY": "API_SECRET_KEY_PROD",
        "DATABASE_URL": "DATABASE_URL_PROD",
        "REDIS_URL": "REDIS_URL_PROD",
        "WEBHOOK_SECRET": "WEBHOOK_SECRET_PROD",
        "ENCRYPTION_KEY": "ENCRYPTION_KEY_PROD",
        "JWT_SECRET": "JWT_SECRET_PROD",
        "OAUTH_CLIENT_SECRET": "OAUTH_CLIENT_SECRET_PROD",
        "EMAIL_API_KEY": "EMAIL_API_KEY_PROD",
        "SMS_API_KEY": "SMS_API_KEY_PROD",
        "STORAGE_ACCESS_KEY": "STORAGE_ACCESS_KEY_PROD",
        "MONITORING_API_KEY": "MONITORING_API_KEY_PROD"
      },
      "staging": {
        "ENVIRONMENT": "staging",
        "API_SECRET_KEY": "API_SECRET_KEY_STAGING",
        "DATABASE_URL": "DATABASE_URL_STAGING",
        "REDIS_URL": "REDIS_URL_STAGING",
        "WEBHOOK_SECRET": "WEBHOOK_SECRET_STAGING",
        "ENCRYPTION_KEY": "ENCRYPTION_KEY_STAGING",
        "JWT_SECRET": "JWT_SECRET_STAGING",
        "OAUTH_CLIENT_SECRET": "OAUTH_CLIENT_SECRET_STAGING",
        "EMAIL_API_KEY": "EMAIL_API_KEY_STAGING",
        "SMS_API_KEY": "SMS_API_KEY_STAGING",
        "STORAGE_ACCESS_KEY": "STORAGE_ACCESS_KEY_STAGING",
        "MONITORING_API_KEY": "MONITORING_API_KEY_STAGING"
      },
      "preview": {
        "ENVIRONMENT": "preview",
        "API_SECRET_KEY": "API_SECRET_KEY_PREVIEW",
        "DATABASE_URL": "DATABASE_URL_PREVIEW",
        "REDIS_URL": "REDIS_URL_PREVIEW",
        "WEBHOOK_SECRET": "WEBHOOK_SECRET_PREVIEW",
        "ENCRYPTION_KEY": "ENCRYPTION_KEY_PREVIEW",
        "JWT_SECRET": "JWT_SECRET_PREVIEW",
        "OAUTH_CLIENT_SECRET": "OAUTH_CLIENT_SECRET_PREVIEW",
        "EMAIL_API_KEY": "EMAIL_API_KEY_PREVIEW",
        "SMS_API_KEY": "SMS_API_KEY_PREVIEW",
        "STORAGE_ACCESS_KEY": "STORAGE_ACCESS_KEY_PREVIEW",
        "MONITORING_API_KEY": "MONITORING_API_KEY_PREVIEW"
      }
    }
  },
  "headers": {
    "/*": {
      "X-Frame-Options": "DENY",
      "X-Content-Type-Options": "nosniff",
      "X-XSS-Protection": "1; mode=block",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
      "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; media-src 'self' https:; object-src 'none'; frame-src 'self' https://challenges.cloudflare.com; connect-src 'self' wss: https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests",
      "Cache-Control": "public, max-age=31536000, immutable"
    },
    "/api/*": {
      "X-Robots-Tag": "noindex",
      "Cache-Control": "no-cache, no-store, must-revalidate"
    },
    "/*.html": {
      "Cache-Control": "public, max-age=3600"
    },
    "/_next/static/*": {
      "Cache-Control": "public, max-age=31536000, immutable"
    },
    "/images/*": {
      "Cache-Control": "public, max-age=2592000"
    },
    "/fonts/*": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  },
  "redirects": {
    "/old-dashboard": {
      "to": "/dashboard",
      "status": 301
    },
    "/old-landing": {
      "to": "/",
      "status": 301
    },
    "/signup-old": {
      "to": "/signup",
      "status": 301
    },
    "/login-old": {
      "to": "/login",
      "status": 301
    }
  },
  "advanced": {
    "custom_domains": [
      {
        "domain": "protothrive.com",
        "certificate_authority": "cloudflare",
        "validation_method": "dns"
      },
      {
        "domain": "www.protothrive.com",
        "certificate_authority": "cloudflare",
        "validation_method": "dns"
      },
      {
        "domain": "app.protothrive.com",
        "certificate_authority": "cloudflare",
        "validation_method": "dns"
      }
    ],
    "edge_side_includes": {
      "enabled": true
    },
    "browser_rendering": {
      "enabled": true
    },
    "early_hints": {
      "enabled": true
    },
    "automatic_https_rewrites": true,
    "always_use_https": true,
    "brotli_compression": true,
    "minify": {
      "html": true,
      "css": true,
      "js": true
    },
    "email_obfuscation": true,
    "server_side_excludes": true,
    "hotlink_protection": true,
    "ip_geolocation": {
      "enabled": true
    },
    "pseudo_ipv4": true,
    "websocket": {
      "enabled": true
    },
    "grpc": {
      "enabled": false
    },
    "http2": {
      "enabled": true
    },
    "http3": {
      "enabled": true
    },
    "zero_rtt": {
      "enabled": true
    },
    "tls_1_3": {
      "enabled": true
    },
    "automatic_platform_optimization": {
      "enabled": true,
      "cache_by_device_type": true
    },
    "polish": {
      "enabled": true,
      "webp": true,
      "avif": true
    },
    "mirage": {
      "enabled": true
    },
    "rocket_loader": {
      "enabled": false
    }
  },
  "compatibility": {
    "flags": [
      "streams_enable_constructors",
      "transformstream_enable_standard_constructor"
    ],
    "date": "2024-01-01"
  }
}
{
  "name": "protothrive-deploy",
  "version": "2.0.0",
  "private": true,
  "description": "ProtoThrive Production Deployment - Optimized build for Cloudflare Pages",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && next export",
    "build:production": "cross-env NODE_ENV=production next build && next export",
    "start": "next start -p 3000",
    "lint": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "deploy:cloudflare": "npm run build:production && wrangler pages deploy out --project-name protothrive",
    "validate": "npm run typecheck && npm run lint && npm run test:ci"
  },
  "dependencies": {
    "@splinetool/react-spline": "^2.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.8",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "18.3.24",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.4",
    "jest": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.4.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

{
  "name": "ProtoThrive Enterprise Secrets Management",
  "description": "Comprehensive secrets and environment variables configuration",
  "version": "2.0.0",
  "environments": {
    "production": {
      "secrets": {
        "core_application": {
          "JWT_SECRET": {
            "description": "JWT signing secret for authentication tokens",
            "required": true,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^[A-Za-z0-9+/]{64,}$"
          },
          "ENCRYPTION_KEY": {
            "description": "AES-256 encryption key for sensitive data",
            "required": true,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^[A-Fa-f0-9]{64}$"
          },
          "API_SECRET_KEY": {
            "description": "Secret key for API authentication",
            "required": true,
            "rotation_days": 60,
            "source": "vault",
            "validation": "^[A-Za-z0-9+/]{32,}$"
          },
          "WEBHOOK_SECRET": {
            "description": "Secret for webhook signature verification",
            "required": true,
            "rotation_days": 30,
            "source": "vault",
            "validation": "^[A-Za-z0-9+/]{32,}$"
          }
        },
        "database": {
          "DATABASE_ENCRYPTION_KEY": {
            "description": "Database field-level encryption key",
            "required": true,
            "rotation_days": 180,
            "source": "vault",
            "validation": "^[A-Fa-f0-9]{64}$"
          },
          "BACKUP_ENCRYPTION_KEY": {
            "description": "Database backup encryption key",
            "required": true,
            "rotation_days": 180,
            "source": "vault",
            "validation": "^[A-Fa-f0-9]{64}$"
          }
        },
        "external_services": {
          "CLERK_SECRET_KEY": {
            "description": "Clerk authentication service secret",
            "required": true,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^sk_live_[A-Za-z0-9]{32,}$"
          },
          "STRIPE_SECRET_KEY": {
            "description": "Stripe payment processing secret",
            "required": true,
            "rotation_days": 120,
            "source": "vault",
            "validation": "^sk_live_[A-Za-z0-9]{99}$"
          },
          "STRIPE_WEBHOOK_SECRET": {
            "description": "Stripe webhook endpoint secret",
            "required": true,
            "rotation_days": 60,
            "source": "vault",
            "validation": "^whsec_[A-Za-z0-9+/]{32,}$"
          },
          "SENDGRID_API_KEY": {
            "description": "SendGrid email service API key",
            "required": true,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}$"
          },
          "TWILIO_AUTH_TOKEN": {
            "description": "Twilio SMS service authentication token",
            "required": false,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^[a-f0-9]{32}$"
          }
        },
        "monitoring": {
          "SENTRY_DSN": {
            "description": "Sentry error tracking DSN",
            "required": true,
            "rotation_days": 180,
            "source": "vault",
            "validation": "^https://[a-f0-9]{32}@[a-f0-9]+\\.ingest\\.sentry\\.io/[0-9]+$"
          },
          "DATADOG_API_KEY": {
            "description": "Datadog monitoring API key",
            "required": true,
            "rotation_days": 120,
            "source": "vault",
            "validation": "^[a-f0-9]{32}$"
          },
          "MIXPANEL_SECRET": {
            "description": "Mixpanel analytics secret key",
            "required": true,
            "rotation_days": 120,
            "source": "vault",
            "validation": "^[a-f0-9]{32}$"
          }
        },
        "integrations": {
          "GITHUB_APP_PRIVATE_KEY": {
            "description": "GitHub App private key for API access",
            "required": true,
            "rotation_days": 365,
            "source": "vault",
            "validation": "^-----BEGIN.*PRIVATE KEY-----[\\s\\S]*-----END.*PRIVATE KEY-----$"
          },
          "GITHUB_WEBHOOK_SECRET": {
            "description": "GitHub webhook secret for signature verification",
            "required": true,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^[A-Za-z0-9+/]{32,}$"
          },
          "SLACK_BOT_TOKEN": {
            "description": "Slack bot OAuth token for workspace integration",
            "required": true,
            "rotation_days": 180,
            "source": "vault",
            "validation": "^xoxb-[0-9]+-[0-9]+-[A-Za-z0-9]{24}$"
          },
          "SLACK_WEBHOOK_URL": {
            "description": "Slack webhook URL for notifications",
            "required": true,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^https://hooks\\.slack\\.com/services/[A-Z0-9]{9}/[A-Z0-9]{11}/[A-Za-z0-9]{24}$"
          },
          "JIRA_API_TOKEN": {
            "description": "Jira API token for project integration",
            "required": false,
            "rotation_days": 90,
            "source": "vault",
            "validation": "^[A-Za-z0-9]{24}$"
          }
        },
        "sso_providers": {
          "AZURE_AD_CLIENT_SECRET": {
            "description": "Azure AD OAuth client secret",
            "required": true,
            "rotation_days": 180,
            "source": "vault",
            "validation": "^[A-Za-z0-9+/=]{32,}$"
          },
          "GOOGLE_OAUTH_CLIENT_SECRET": {
            "description": "Google OAuth client secret",
            "required": true,
            "rotation_days": 180,
            "source": "vault",
            "validation": "^[A-Za-z0-9_-]{24}$"
          },
          "OKTA_CLIENT_SECRET": {
            "description": "Okta SSO client secret",
            "required": false,
            "rotation_days": 180,
            "source": "vault",
            "validation": "^[A-Za-z0-9_-]{32,}$"
          },
          "SAML_PRIVATE_KEY": {
            "description": "SAML signing private key",
            "required": true,
            "rotation_days": 365,
            "source": "vault",
            "validation": "^-----BEGIN.*PRIVATE KEY-----[\\s\\S]*-----END.*PRIVATE KEY-----$"
          }
        }
      },
      "environment_variables": {
        "public": {
          "ENVIRONMENT": "production",
          "SERVICE_NAME": "protothrive-backend",
          "API_VERSION": "v1",
          "CLOUDFLARE_ACCOUNT_ID": "d2897bdebfa128919bd89b265e6a712e",
          "ALLOWED_ORIGINS": "https://protothrive.com,https://app.protothrive.com",
          "RATE_LIMIT_PER_MIN": "1000",
          "RATE_LIMIT_PER_HOUR": "60000",
          "CACHE_TTL": "300",
          "SESSION_TTL": "86400",
          "MAX_FILE_SIZE": "10485760",
          "SUPPORTED_FILE_TYPES": "jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,ppt,pptx",
          "GDPR_ENABLED": "true",
          "FEATURE_FLAGS": "enterprise,collaboration,sso,analytics,monitoring",
          "LOG_LEVEL": "info",
          "CORS_MAX_AGE": "86400",
          "WEBSOCKET_TIMEOUT": "300000",
          "COLLABORATION_MAX_PARTICIPANTS": "50",
          "API_TIMEOUT": "30000",
          "DATABASE_POOL_SIZE": "10",
          "REDIS_POOL_SIZE": "5"
        },
        "computed": {
          "BUILD_TIMESTAMP": "$CF_PAGES_COMMIT_SHA",
          "DEPLOYMENT_ID": "$CF_PAGES_BRANCH-$CF_PAGES_COMMIT_SHA",
          "WORKER_LOCATION": "$CF_COLO",
          "REQUEST_ID": "$CF_RAY"
        }
      }
    },
    "staging": {
      "secrets": {
        "core_application": {
          "JWT_SECRET": {
            "description": "JWT signing secret for authentication tokens (staging)",
            "required": true,
            "rotation_days": 30,
            "source": "vault",
            "validation": "^[A-Za-z0-9+/]{64,}$"
          },
          "ENCRYPTION_KEY": {
            "description": "AES-256 encryption key for sensitive data (staging)",
            "required": true,
            "rotation_days": 30,
            "source": "vault",
            "validation": "^[A-Fa-f0-9]{64}$"
          },
          "API_SECRET_KEY": {
            "description": "Secret key for API authentication (staging)",
            "required": true,
            "rotation_days": 30,
            "source": "vault",
            "validation": "^[A-Za-z0-9+/]{32,}$"
          }
        },
        "external_services": {
          "CLERK_SECRET_KEY": {
            "description": "Clerk authentication service secret (staging)",
            "required": true,
            "rotation_days": 60,
            "source": "vault",
            "validation": "^sk_test_[A-Za-z0-9]{32,}$"
          },
          "STRIPE_SECRET_KEY": {
            "description": "Stripe payment processing secret (staging)",
            "required": true,
            "rotation_days": 60,
            "source": "vault",
            "validation": "^sk_test_[A-Za-z0-9]{99}$"
          }
        }
      },
      "environment_variables": {
        "public": {
          "ENVIRONMENT": "staging",
          "SERVICE_NAME": "protothrive-backend-staging",
          "API_VERSION": "v1",
          "ALLOWED_ORIGINS": "https://staging.protothrive.com,https://staging-app.protothrive.com",
          "RATE_LIMIT_PER_MIN": "2000",
          "RATE_LIMIT_PER_HOUR": "120000",
          "CACHE_TTL": "60",
          "SESSION_TTL": "43200",
          "GDPR_ENABLED": "true",
          "FEATURE_FLAGS": "enterprise,collaboration,sso,analytics,monitoring,beta,experimental",
          "LOG_LEVEL": "debug",
          "WEBSOCKET_TIMEOUT": "60000",
          "COLLABORATION_MAX_PARTICIPANTS": "20"
        }
      }
    },
    "development": {
      "secrets": {
        "core_application": {
          "JWT_SECRET": {
            "description": "JWT signing secret for authentication tokens (development)",
            "required": true,
            "rotation_days": 7,
            "source": "local",
            "validation": "^[A-Za-z0-9+/]{32,}$"
          },
          "ENCRYPTION_KEY": {
            "description": "AES-256 encryption key for sensitive data (development)",
            "required": true,
            "rotation_days": 7,
            "source": "local",
            "validation": "^[A-Fa-f0-9]{32,}$"
          }
        }
      },
      "environment_variables": {
        "public": {
          "ENVIRONMENT": "development",
          "SERVICE_NAME": "protothrive-backend-dev",
          "API_VERSION": "v1",
          "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
          "RATE_LIMIT_PER_MIN": "10000",
          "CACHE_TTL": "10",
          "SESSION_TTL": "3600",
          "GDPR_ENABLED": "false",
          "FEATURE_FLAGS": "enterprise,collaboration,sso,analytics,monitoring,beta,experimental,debug",
          "LOG_LEVEL": "debug",
          "WEBSOCKET_TIMEOUT": "30000"
        }
      }
    }
  },
  "secret_rotation": {
    "enabled": true,
    "notification_channels": ["ops@protothrive.com", "security@protothrive.com"],
    "warning_days": 7,
    "automated_rotation": {
      "enabled": true,
      "max_attempts": 3,
      "backoff_multiplier": 2,
      "environments": ["staging", "development"]
    },
    "manual_approval_required": {
      "environments": ["production"],
      "secret_types": ["JWT_SECRET", "ENCRYPTION_KEY", "DATABASE_ENCRYPTION_KEY"]
    }
  },
  "access_control": {
    "roles": {
      "admin": {
        "permissions": ["read", "write", "rotate", "delete"],
        "environments": ["production", "staging", "development"]
      },
      "ops": {
        "permissions": ["read", "rotate"],
        "environments": ["production", "staging", "development"]
      },
      "developer": {
        "permissions": ["read"],
        "environments": ["staging", "development"]
      },
      "ci_cd": {
        "permissions": ["read"],
        "environments": ["production", "staging"],
        "secret_types": ["public_only"]
      }
    },
    "audit_logging": {
      "enabled": true,
      "events": ["access", "rotation", "creation", "deletion", "permission_change"],
      "retention_days": 2555 // 7 years
    }
  },
  "encryption": {
    "at_rest": {
      "algorithm": "AES-256-GCM",
      "key_derivation": "PBKDF2",
      "iterations": 100000
    },
    "in_transit": {
      "tls_version": "1.3",
      "cipher_suites": ["TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256"]
    }
  },
  "compliance": {
    "standards": ["SOC2", "ISO27001", "GDPR", "CCPA"],
    "requirements": {
      "encryption_at_rest": true,
      "encryption_in_transit": true,
      "access_logging": true,
      "regular_rotation": true,
      "principle_of_least_privilege": true,
      "multi_factor_authentication": true
    }
  },
  "monitoring": {
    "secret_access_alerts": {
      "enabled": true,
      "threshold_per_hour": 100,
      "channels": ["security@protothrive.com", "slack_security_channel"]
    },
    "rotation_status_monitoring": {
      "enabled": true,
      "check_frequency": "daily",
      "alert_before_expiry_days": 7
    },
    "anomaly_detection": {
      "enabled": true,
      "ml_model": "isolation_forest",
      "sensitivity": "medium"
    }
  },
  "backup_and_recovery": {
    "backup_frequency": "daily",
    "retention_period": "90_days",
    "encryption": true,
    "cross_region_replication": true,
    "recovery_time_objective": "4_hours",
    "recovery_point_objective": "1_hour"
  }
}
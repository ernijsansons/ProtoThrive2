# Backend Development Dockerfile - Ref: CLAUDE.md Terminal 1
FROM node:20-alpine

WORKDIR /app

# Install development tools
RUN apk add --no-cache git python3 make g++

# Install global packages
RUN npm install -g wrangler nodemon typescript

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install all dependencies (including dev)
RUN npm ci

# Volumes for hot reload
VOLUME ["/app/src", "/app/utils", "/app/migrations"]

# Environment variables
ENV NODE_ENV=development
ENV PORT=8787

# Expose port and debugger port
EXPOSE 8787 9229

# Start with nodemon for hot reload
CMD ["nodemon", "--watch", "src", "--watch", "utils", "--ext", "ts,js", "--exec", "wrangler dev --port 8787 --ip 0.0.0.0 --local"]
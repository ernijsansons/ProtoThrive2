# ProtoThrive Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Database Configuration
D1_DATABASE_ID=your_d1_database_id_here
KV_NAMESPACE_ID=your_kv_namespace_id_here
KV_NAMESPACE_PREVIEW_ID=your_kv_preview_namespace_id_here

# Authentication Secrets
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_PUBLIC_KEY=your_jwt_public_key_for_rs256
JWT_PRIVATE_KEY=your_jwt_private_key_for_rs256

# API Keys (for external services)
ENTERPRISE_AGENT_URL=https://your-enterprise-agent-endpoint
ENTERPRISE_AGENT_TOKEN=your_enterprise_agent_token
OPENAI_API_KEY=your_openai_api_key_if_needed
SOURCEGRAPH_API_KEY=your_sourcegraph_key_if_needed

# Security Configuration
ALLOWED_ORIGINS=https://protothrive.com,https://app.protothrive.com
RATE_LIMIT_PER_MINUTE=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Agent Configuration
AGENT_MODE=fallback
AGENT_BUDGET_DEFAULT=0.40
AGENT_BUDGET_MAX=1.00
AGENT_BUDGET_FALLBACK_MIN=0.05
AGENT_CONFIDENCE_THRESHOLD=0.8

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_here
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
LOG_LEVEL=info

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_ADVANCED_LOGGING=false
ENABLE_METRICS_COLLECTION=true

# Environment
ENVIRONMENT=development
SERVICE_NAME=protothrive-backend
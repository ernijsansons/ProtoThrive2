{
  "name": "protothrive-backend-thermo",
  "version": "2.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc && echo 'Backend TypeScript compilation successful'",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "jest",
    "lint": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "wrangler d1 execute protothrive-thermo --file=migrations/001_init.sql",
    "migrate:remote": "wrangler d1 execute protothrive-thermo --file=migrations/001_init.sql --remote"
  },
  "keywords": [
    "protothrive",
    "backend",
    "cloudflare-workers",
    "hono",
    "typescript",
    "thermonuclear"
  ],
  "author": "ProtoThrive Team",
  "license": "MIT",
  "description": "ProtoThrive Thermonuclear Backend API - Ref: CLAUDE.md Phase 1",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2",
    "wrangler": "^4.32.0"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "graphql": "^16.8.0",
    "graphql-yoga": "^5.0.0",
    "hono": "^4.0.0",
    "jose": "^5.10.0",
    "zod": "^3.22.0"
  }
}

# Ref: CLAUDE.md Thermonuclear Environment Configuration Template
# ProtoThrive Environment Variables Template
# Copy this to .env and fill in your actual values

# ========================================
# THERMONUCLEAR DEPLOYMENT CONFIGURATION
# ========================================

# AI Model Configuration
CLAUDE_API_KEY=sk-ant-your_claude_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
KIMI_API_KEY=your_kimi_api_key_here
UX_PILOT_KEY=your_ux_pilot_key_here

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_cloudflare_account_id
D1_ID=your_d1_database_id
KV_ID=your_kv_namespace_id

# Database Configuration
DATABASE_URL=your_database_connection_string
D1_DATABASE_ID=your_d1_database_id
KV_NAMESPACE_ID=your_kv_namespace_id

# Deployment Platforms
VERCEL_TOKEN=your_vercel_deployment_token
VERCEL_PROJECT_ID=your_vercel_project_id

# Authentication & Security (CRITICAL - MUST BE CRYPTOGRAPHICALLY SECURE)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
JWT_SECRET=your_64_character_minimum_cryptographically_secure_jwt_secret_here
JWT_REFRESH_SECRET=your_64_character_minimum_refresh_token_secret_here
AUTH_SECRET=your_64_character_minimum_authentication_secret_here
ADMIN_PASSWORD=your_secure_admin_password_here_minimum_16_chars
ENCRYPTION_KEY=your_256_bit_encryption_key_here

# Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# External Services
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=protothrive-rag

# Monitoring & Analytics
DATADOG_API_KEY=your_datadog_api_key
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_API_KEY=your_analytics_key

# Automation & Workflows
N8N_SECRET=your_n8n_webhook_secret
SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_CHANNEL=#protothrive-alerts

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.protothrive.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
SPLINE_SCENE_URL=https://prod.spline.design/your-spline-scene/scene.splinecode

# Development Settings
NODE_ENV=production
PORT=8787
FRONTEND_PORT=3000
REDIS_URL=redis://localhost:6379

# Thermonuclear Specific
BUDGET_PER_TASK=0.10
THRIVE_SCORE_THRESHOLD=0.5
HITL_SLACK_CHANNEL=#hitl-alerts
AUTO_DEPLOY_ENABLED=true
NEON_MODE_ENABLED=true

# Health Check URLs
HEALTH_CHECK_URL=https://api.protothrive.com/health
FRONTEND_HEALTH_URL=https://protothrive.com/api/health

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# Security Headers
CORS_ORIGIN=https://protothrive.com,https://www.protothrive.com
CSP_ENABLED=true
HSTS_ENABLED=true

# Cache Configuration
CACHE_TTL_SECONDS=3600
REDIS_CACHE_PREFIX=protothrive:
ENABLE_CACHING=true

# Feature Flags
ENABLE_BETA_FEATURES=false
ENABLE_DEBUG_MODE=false
ENABLE_PERFORMANCE_MONITORING=true

# ProtoThrive2 Environment Configuration
# SECURITY: Configure all variables before deployment

# Authentication & JWT (REQUIRED)
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits
JWT_PUBLIC_KEY=your-jwt-public-key-for-verification
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=your-32-character-encryption-key-here

# Admin Credentials (REQUIRED - NO DEFAULTS)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=your-secure-admin-password

# Budget & Rate Limiting
MAX_DAILY_BUDGET=10.0
COST_PER_REQUEST=0.05
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Cloudflare Configuration (REQUIRED)
CLOUDFLARE_ACCOUNT_ID=your-account-id
D1_DATABASE_ID=your-d1-database-id
KV_NAMESPACE_ID=your-kv-namespace-id

# AI API Keys
CLAUDE_API_KEY=your-claude-api-key
KIMI_API_KEY=your-kimi-api-key
UXPILOT_API_KEY=your-uxpilot-api-key

# Environment
ENVIRONMENT=production
LOG_LEVEL=info

# CORS & Security
ALLOWED_ORIGINS=https://your-domain.com,https://your-admin-domain.com
SECURITY_HEADERS=true

# Database Security
DB_ENCRYPTION_AT_REST=true
DB_BACKUP_ENABLED=true

# Monitoring & Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
ERROR_REPORTING=true
SENTRY_DSN=your_sentry_dsn_here

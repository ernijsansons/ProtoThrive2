# ProtoThrive Production Environment Variables
# CRITICAL: Replace placeholder values with actual production credentials

# Cloudflare Configuration (REQUIRED)
CLOUDFLARE_ACCOUNT_ID=d2897bdebfa128919bd89b265e6a712e
CLOUDFLARE_API_TOKEN=your_actual_api_token_here

# Database Configuration (REQUIRED)
D1_DATABASE_ID=0b6970f4-c6ca-4245-aabf-98fa2d4f28a8
KV_NAMESPACE_ID=ec3183e7b4e94442b3f99b4d2f4b083e
KV_NAMESPACE_PREVIEW_ID=ec3183e7b4e94442b3f99b4d2f4b083e

# Authentication (REQUIRED - Generate secure values)
JWT_SECRET=protothrive_jwt_secret_min_32_characters_change_this
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0Z6y8...
-----END PUBLIC KEY-----
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...
-----END PRIVATE KEY-----

# API Configuration
NEXT_PUBLIC_API_URL=https://backend-thermo.ernijs-ansons.workers.dev
NEXT_PUBLIC_APP_URL=https://protothrive-frontend.pages.dev

# AI Service Configuration
ENTERPRISE_AGENT_URL=https://enterprise-agent.protothrive.com
ENTERPRISE_AGENT_TOKEN=agent_token_here
OPENAI_API_KEY=sk-...your_openai_key_if_needed
KIMI_API_KEY=kimi_api_key_here
CLAUDE_API_KEY=sk-ant-...your_claude_key_here

# Security Configuration
ALLOWED_ORIGINS=https://protothrive-frontend.pages.dev,https://protothrive.com,http://localhost:3000
RATE_LIMIT_PER_MINUTE=100
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Agent Configuration
AGENT_MODE=fallback
AGENT_BUDGET_DEFAULT=0.10
AGENT_BUDGET_MAX=1.00
AGENT_CONFIDENCE_THRESHOLD=0.8

# Monitoring
SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=your_sentry_token
LOG_LEVEL=info

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_ADVANCED_LOGGING=true
ENABLE_METRICS_COLLECTION=true
ENABLE_AI_FEATURES=true

# Environment
NODE_ENV=production
ENVIRONMENT=production
SERVICE_NAME=protothrive-backend